# LoseSound configuration.
#
# The easiest way to create this file is:
#   python3 scripts/setup.py
#
# Required: the LAN address of the machine that runs Docker and the speaker IP.
SERVICE_HOST=192.168.1.10
SPEAKER_IP=192.168.1.50
# Optional: comma separated list of speakers the web UI should check.
# SPEAKER_IPS=192.168.1.50,192.168.1.51

# ---------------------------------------------------------------------------
# Ports (defaults match the documentation)
# ---------------------------------------------------------------------------
# AFTERTOUCH_HTTP_PORT=8091
# AFTERTOUCH_HTTPS_PORT=8444
# PROXY_PORT=8092
# SPEAKER_PORT=8090

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# AfterTouch release. See docs/UPGRADING.md before changing it.
# SOUNDTOUCH_VERSION=0.138.1
# LoseSound image tag. "latest" is fine for a first install; pin for servers.
# LOSESOUND_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Stream relay defaults (can also be changed in the web UI)
# ---------------------------------------------------------------------------
# BUFFER_SECONDS=3
# PREBUFFER_SECONDS=2
# BITRATE_KBPS=128
# RECONNECT_BACKOFF_MS=250,500,1000,2000,3000
# Default playback mode for new presets: auto, relay, speaker, radioBrowser, orion
# DEFAULT_PRESET_MODE=auto
# Legacy seeding: 0 sets the default mode to speaker instead of relay.
# AUDIO_PROXY_ENABLED=1

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# LOG_STREAM_CHUNKS=0
# Log full URLs including stream tokens (off by default).
# LOG_URL_QUERY=0
# Prefer IPv4 for outbound HTTP(S); set to 0 on IPv6-only networks.
# NET_FORCE_IPV4=1
# RADIO_BROWSER_BASE_URL=https://de1.api.radio-browser.info

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Optional shared token for write requests (POST/DELETE). The UI asks for it
# once and stores it in the browser's localStorage.
# API_TOKEN=
