# Usually generated by:
#   python3 scripts/setup.py
#
# Required network-specific values:
SERVICE_HOST=10.10.10.85
SPEAKER_IP=10.10.10.26
# Optional: comma-separated speakers to check in the UI.
# SPEAKER_IPS=10.10.10.26,10.10.10.27
#
# Optional overrides:
# AFTERTOUCH_HTTP_PORT=8091
# AFTERTOUCH_HTTPS_PORT=8444
# PROXY_PORT=8092
# BUFFER_SECONDS=3
# BITRATE_KBPS=128
# RECONNECT_BACKOFF_MS=250,500,1000,2000,3000
# LOG_STREAM_CHUNKS=0
# RADIO_BROWSER_BASE_URL=https://de1.api.radio-browser.info
